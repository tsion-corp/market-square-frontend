# Upstream gateway. Leave unset to run in fixture mode: the BFF serves
# realistic sample data from lib/fixtures and the whole app demos standalone.
# WSAPI_BASE_URL=https://gateway.example.com

# Decane auth. Leave the app id unset for fixture/demo mode (a demo session is
# assumed). Set it to enable real sign-in and server-side token verification.
# DECANE_API_KEY is SERVER-ONLY: the browser fetches it from /api/decane/key at
# runtime, and its allowed_origins in Decane must name both of Square's hosts.
# Never set a NEXT_PUBLIC_ copy of it. DECANE_VERIFICATION_KEY (an ES256 SPKI
# PEM) is optional: set, tokens verify offline instead of via Decane's JWKS.
# NEXT_PUBLIC_DECANE_APP_ID=
# DECANE_API_KEY=
# DECANE_VERIFICATION_KEY=

# Privy — LEGACY, for the move to Decane only. The app id powers the "Bring
# your old account" page (/move-account); the secret lets the BFF keep
# accepting pre-migration Privy sessions until they age out, and verify the old
# token on an account link. Remove both when the link window closes.
# NEXT_PUBLIC_PRIVY_APP_ID=
# PRIVY_APP_SECRET=

# Account linking (/v1/migration on the gateway). OFF unless "1". Only turn it
# on where WSAPI_BASE_URL's gateway actually has a `migration` entry (staging
# does, production does not yet) — never point one environment's identities at
# another's service. MIGRATION_API_URL overrides the base for a local service.
# MIGRATION_SERVICE_ENABLED=1
# MIGRATION_API_URL=http://localhost:3000/v1/migration

# Destination for the WorldStreet slide's "Join now" in the Ecosystem
# Partners rail (overrides the built-in default). There is no longer a
# WorldStreet nav entry — that rail is the only door to the platform left.
NEXT_PUBLIC_WORLDSTREET_URL=https://worldstreetgold.com

# The KASH engine. Unset, it derives from WSAPI_BASE_URL as
# ${WSAPI_BASE_URL}/v1/kash. Set it to point one service at a different
# environment while the rest of the app stays on the gateway. With neither set,
# the KASH balance and the Get KASH sheet go quiet rather than erroring.
# KASH_API_URL=https://api.tsionark.com/v1/kash

# Server-only. The routing provider's key for $TICKER buys. Unset, the ticker
# sheet still opens and shows the coin and its price; it just says buying is
# not available here. DEXTOPUS_API_KEY is honoured as a fallback.
# DEXTOPUS_TRADE_API_KEY=

# Gas sponsorship, behind our own session-gated proxy. This is what makes a
# purchase possible at all: an embedded wallet funded with USDC alone has no
# ETH to pay Base gas with, so without these every send fails.
#
# ALCHEMY_API_KEY IS A COMMA-SEPARATED LIST, walked in order. One key was a
# single point of failure: when that Alchemy app hit its rate limit, every
# sponsored send failed at once and nobody could buy coins. Reads survive a
# throttled key because they fall back; sponsorship cannot, because nothing
# else pays our gas.
#
# ALCHEMY_GAS_POLICY_ID is INDEX-ALIGNED with it. A Gas Manager policy belongs
# to the Alchemy app that created it, so the key at index N is only ever sent
# with the policy at index N — a mismatched pair is answered "Policy not
# found". Leave a slot blank (",,") for a key with no policy; it then reads but
# never sponsors. A key that answers capacity, a rate limit or an auth error is
# skipped for a cooldown rather than asked again.
#
#   ALCHEMY_API_KEY=k0,k1,k2
#   ALCHEMY_GAS_POLICY_ID=p0,,p2      <- k1 reads, never sponsors
#
# See wsws ADR-2026-09-07-alchemy-key-pool, which this is ported from.
# ALCHEMY_API_KEY=
# ALCHEMY_GAS_POLICY_ID=
# Deprecated: appended after the list above. Move the key into the list.
# ALCHEMY_API_KEY_FALLBACK=

# EVM reads go to ZeroDev FIRST and only fall through to the Alchemy pool.
# Reads are the bulk of our RPC traffic — every balance, the eth_getCode and
# nonce on the sponsored send path, and every receipt poll — and putting them
# on the same key that sponsors is what let read volume break purchases. With
# this set, a throttled Alchemy key no longer takes the app's reads with it.
# One project serves every supported chain. Server-only; never NEXT_PUBLIC_*.
# ZERODEV_PROJECT_ID=

# Live gift tray: prices, KASH totals and the coin chrome. OFF shows the free
# tray — the shared on-stream moment with no money leg and no payment language.
# Turn ON only once profiles carry a wallet, or every gift fails with
# "This author has no wallet to receive tips" AFTER the burst has played.
# Inlined at BUILD time (NEXT_PUBLIC_): needs a rebuild, not a restart.
NEXT_PUBLIC_MS_LIVE_GIFTS_ENABLED=false

# Houses: audio-only rooms where anyone can open a table and raise a hand.
# This gates PROMOTION only — the nav entry and the "Open a house" door.
# /houses/[id] always resolves, because a link somebody was sent has to work.
# Inlined at BUILD time (NEXT_PUBLIC_): needs a rebuild, not a restart.
NEXT_PUBLIC_MS_HOUSES_ENABLED=false

# The desktop sidebar. Off by default: BottomDock replaced it on every size, so
# the dock is the app's only navigation. `true` brings the sidebar back on
# desktop and steps the dock back to phones, so the two never both claim it.
# A LAYOUT SWITCH, not a capability — nothing is greyed out either way.
# NEXT_PUBLIC_* is inlined at BUILD time: set it, then REBUILD, not just restart.
NEXT_PUBLIC_MS_SIDEBAR_ENABLED=false

# ws-gateway: a realtime "the lane's head changed" signal for the home feed,
# layered on the 30-second head check, which stays as the floor. ABSENT means
# no socket is ever opened — the poll runs alone. Set to the gateway origin.
# Inlined at BUILD time (NEXT_PUBLIC_): needs a rebuild, not a restart.
# NEXT_PUBLIC_MS_WS_GATEWAY_URL=wss://ws.example.com/

# Server-only. Link previews — the Open Graph card a shared post or profile
# unfurls into on WhatsApp, X, Telegram and the rest. Unset means ON. Set to
# `off` to make every post and profile publish the generic Square card with no
# request to the service: the one-deploy stop if a preview ever shows something
# it should not. Crawlers cache previews for days, so turning this off stops
# NEW cards; it cannot recall ones already cached.
# SHARE_PREVIEWS=off

# Mixpanel, the analytics transport that exists today.
#
# The PROJECT token, which is write-only and designed to sit in client code —
# it cannot read a project. Unset means analytics is a no-op, which is the
# correct state for a local checkout and for any environment that should not
# report. Never put the API SECRET here: it is a different credential and
# nothing in this app reads one.
NEXT_PUBLIC_MIXPANEL_TOKEN=
#
# Optional. A first-party path on our own origin to proxy ingest through.
# Unset, the browser calls api.mixpanel.com directly and most ad-blockers stop
# it — an uneven undercount, since the people who block are not a random
# sample. Set this once a proxy route exists and nothing else changes.
NEXT_PUBLIC_MIXPANEL_PROXY=

# ─── GameArena, for the games playable inside a chat ─────────────────────────
#
# Both unset is the correct state for a local checkout, and it is a SUPPORTED
# state everywhere: the game plays, the score lands in the thread, and only the
# leaderboard write is absent. Nothing errors and no player is told anything.
# GameArena's own partner routes behave the same way until a partner is
# configured, so this mirrors their side deliberately.

# Their backend, no trailing slash.
GAMEARENA_API_URL=

# The partner key they issue for Square specifically.
#
# SERVER ONLY — no NEXT_PUBLIC_ prefix, and it must never gain one. Upstream
# this key IS the authority: whoever holds it can write any score against any
# wallet. It is read in app/api/gamearena/* and nowhere else, and it is the
# only credential of theirs Square holds. Their score validator key, their
# faucet key and their database credentials stay on their side.
GAMEARENA_PARTNER_KEY=

# Optional. The GamePass contract, if it is ever redeployed.
#
# Defaults to the live one on Celo mainnet, so this stays unset in normal use.
# NEXT_PUBLIC_ because the browser reads name availability and sends the claim
# directly — a contract address is public by nature and is not a credential.
NEXT_PUBLIC_GAME_PASS_ADDRESS=

# Let somebody claim a player name BEFORE proving they are a real person.
#
# UNSET IS THE PRODUCTION RULE: verification is REQUIRED, because a score only
# counts for GameArena when it belongs to a verified human — that is the point
# of the integration, and their own target is verified humans, not wallets.
#
# "true" reverses the order for testing, so the name claim can be exercised
# without standing through a face scan every time. Note that gas for a claim is
# funded only for verified humans, so an unverified claim can still fail for
# want of it — the screen says so when it happens.
NEXT_PUBLIC_MS_GAMES_VERIFY_OPTIONAL=
